# Application
APP_NAME="Globe Notes API"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
# SQLite for local development
DATABASE_URL=sqlite+aiosqlite:///./globe_notes.db
# PostgreSQL for production
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/globe_notes
DATABASE_ECHO=false

# Security
# IMPORTANT: Change this in production!
IP_HASH_SALT=change-this-secret-salt-in-production

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_HOURS=1

# Geolocation
GEOLOCATION_TIMEOUT=5.0
GEOLOCATION_PROVIDER=ipapi

# Content Filter
CONTENT_FILTER_ENABLED=true
